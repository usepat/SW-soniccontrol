

{% macro uint8_layout(field_name, address) %}
<tr>
    <td>{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td>uint8</td>
    <td>{{ address }}</td>
    <td>0x00</td>
    <td>value</td>
</tr>
{% endmacro %}

{% macro uint16_layout(field_name, address) %}
<tr>
    <td>{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td>uint16</td>
    <td>{{ address }}</td>
    <td colspan="2">value</td>
</tr>
{% endmacro %}

{% macro int16_layout(field_name, address) %}
<tr>
    <td>{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td>int16</td>
    <td>{{ address }}</td>
    <td colspan="2">value</td>
</tr>
{% endmacro %}

{% macro uint32_layout(field_name, address) %}
<tr>
    <td rowspan="2">{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td rowspan="2">uint32</td>
    <td>{{ address }}</td>
    <td colspan="2">High word</td>
</tr>
<tr>
    <td>{{ address + 1 }}</td>
    <td colspan="2">Low word</td>
</tr>
{% endmacro %}

{% macro float_layout(field_name, address) %}
<tr>
    <td rowspan="2">{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td rowspan="2">float32 IEEE-754</td>
    <td>{{ address }}</td>
    <td colspan="2">High word</td>
</tr>
<tr>
    <td>{{ address + 1 }}</td>
    <td colspan="2">Low word</td>
</tr>
{% endmacro %}

{% macro bool_layout(field_name, address) %}
<tr>
    <td>{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td>bool</td>
    <td>{{ address }}</td>
    <td>0x00</td>
    <td>value</td>
</tr>
{% endmacro %}

{% macro string64_layout(field_name, address) %}
<tr>
    <td rowspan="4">{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td rowspan="4">str</td>
    <td>{{ address }}</td>
    <td colspan="2">String length</td>
</tr>
<tr>
    <td>{{ address + 1}}</td>
    <td>char 0</td>
    <td>char 1</td>
</tr>
<tr>
    <td>...</td>
    <td>...</td>
    <td>...</td>
</tr>
<tr>
    <td>{{ address + 31}}</td>
    <td>char 60</td>
    <td>char 61</td>
</tr>
{% endmacro %}

{% macro enum_layout(field_name, enum_name, address) %}
<tr>
    <td>{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td>enum {{ enum_name }}</td>
    <td>{{ address }}</td>
    <td>Enum value high byte (0x00)</td>
    <td>Enum value low byte</td>
</tr>
{% endmacro %}

{% macro timestamp_layout(field_name, address) %}
<tr>
    <td rowspan="4">{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td rowspan="4">timestamp (posix time, int64)</td>
    <td>{{ address }}</td>
    <td colspan="2">Highest word</td>
</tr>
<tr>
    <td>{{ address + 1 }}</td>
    <td colspan="2">Second-highest word</td>
</tr>
<tr>
    <td>{{ address + 2 }}</td>
    <td colspan="2">Second-lowest word</td>
</tr>
<tr>
    <td>{{ address + 3 }}</td>
    <td colspan="2">Lowest word</td>
</tr>
{% endmacro %}

{% macro version_layout(field_name, address) %}
<tr>
    <td rowspan="3">{{ add_wbr_before_underscore(field_name) | safe }}</td>
    <td rowspan="3">struct version</td>
    <td>{{ address }}</td>
    <td>0x00</td>
    <td>Major version (uint8)</td>
</tr>
<tr>
    <td>{{ address + 1 }}</td>
     <td>0x00</td>
    <td>Minor version (uint8)</td>
</tr>
<tr>
    <td>{{ address + 2 }}</td>
     <td>0x00</td>
    <td>Patch version (uint8)</td>
</tr>
{% endmacro %}


{% macro memory_layout_table(content) %}
    <div class="overflow-x-auto my-2">
    <table class="manual-table w-full min-w-[980px] text-sm border-collapse table-fixed [&_th]:px-3 [&_td]:px-3">
        <colgroup>
            <col class="w-[22%]" />
            <col class="w-[16%]" />
            <col class="w-[10%]" />
            <col class="w-[26%]" />
            <col class="w-[26%]" />
        </colgroup>
        <thead>
            {% set th_class = "text-left py-2" %}
            <tr>
                <th class="{{th_class}}">Name</th>
                <th class="{{th_class}}">Type</th>
                <th class="{{th_class}}">Register</th>
                <th class="{{th_class}}" colspan="2">Register contents</th>
            </tr>
            <tr>
                <th class="{{th_class}}"></th>
                <th class="{{th_class}}"></th>
                <th class="{{th_class}}"></th>
                <th class="{{th_class}}">High byte</th>
                <th class="{{th_class}}">Low byte</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
            {{ content }}
        </tbody>
    </table>
    </div>
{% endmacro %}


{% macro modbus_layout_fields(command_code, fields, start_address=0, is_answer=true) %}
    {% set code_value = command_code.value %}
    {% set code_word = code_value % 65536 %}
    {% set code_high_byte = (code_value // 256) % 256 %}
    {% set code_low_byte = code_value % 256 %}
    {% if not is_answer %}
    <tr class="border-t border-slate-100">
        <td>Execute</td>
        <td>uint8</td>
        <td>{{ start_address }}</td>
        <td>0x00</td>
        <td>Execute flag (set to 1)</td>
    </tr>
    <tr class="border-t border-slate-100">
        {% if is_postman_device %}
        <td>Transceiver Id</td>
        {% else %}
        <td>Reserved</td>
        {% endif %}
        <td>uint8</td>
        <td>{{ start_address + 1 }}</td>
        <td>0x00</td>
        {% if is_postman_device %}
        <td>Used to select the downstream target device</td>
        {% else %}
        <td>Reserved</td>
        {% endif %}
    </tr>
    {% else %}
    {% set answer_length = namespace(words=1) %}
    {% for field in fields %}
        {% set field_type = field.field_type.field_type %}
        {% if field_type == bool or field_type == np.uint8 or issubclass(field_type, Enum) %}
            {% set answer_length.words = answer_length.words + 1 %}
        {% elif field_type == np.uint16 or field_type == np.int16 %}
            {% set answer_length.words = answer_length.words + 1 %}
        {% elif field_type == np.uint32 or field_type == int or field_type == float %}
            {% set answer_length.words = answer_length.words + 2 %}
        {% elif field_type == Timestamp %}
            {% set answer_length.words = answer_length.words + 4 %}
        {% elif field_type == Version %}
            {% set answer_length.words = answer_length.words + 3 %}
        {% elif field_type == str or field_type == bytes %}
            {% set answer_length.words = answer_length.words + 32 %}
        {% endif %}
    {% endfor %}
    {% set answer_length_word = answer_length.words % 65536 %}
    {% set answer_length_high_byte = (answer_length_word // 256) % 256 %}
    {% set answer_length_low_byte = answer_length_word % 256 %}
    <tr class="border-t border-slate-100">
        <td>Pending execution</td>
        <td>uint8</td>
        <td>{{ start_address }}</td>
        <td>0x00</td>
        <td>Pending flag (0/1)</td>
    </tr>
    <tr class="border-t border-slate-100">
        <td>
            <div>Answer length</div>
            <div class="text-xs text-slate-500">Value: {{ answer_length.words }} (0x{{ '%04X' % answer_length_word }})</div>
        </td>
        <td>uint16</td>
        <td>{{ start_address + 1 }}</td>
        <td>
            <div class="font-mono text-slate-800">0x{{ '%02X' % answer_length_high_byte }}</div>
            <div class="text-xs text-slate-500">High Byte (MSB)</div>
        </td>
        <td>
            <div class="font-mono text-slate-800">0x{{ '%02X' % answer_length_low_byte }}</div>
            <div class="text-xs text-slate-500">Low Byte (LSB)</div>
        </td>
    </tr>
    {% endif %}
    <tr class="border-t border-slate-100">
        <td>
            <div>CommandCode</div>
            <div class="text-xs text-slate-500">Value: {{ code_value }} (0x{{ '%04X' % code_word }})</div>
        </td>
        <td>int16</td>
        <td>{{ start_address + 2 }}</td>
        <td>
            <div class="font-mono text-slate-800">0x{{ '%02X' % code_high_byte }}</div>
            <div class="text-xs text-slate-500">High Byte (MSB)</div>
        </td>
        <td>
            <div class="font-mono text-slate-800">0x{{ '%02X' % code_low_byte }}</div>
            <div class="text-xs text-slate-500">Low Byte (LSB)</div>
        </td>
    </tr>
    {% set ns = namespace(address=start_address + 3) %}
    {% for field in fields %}
        {% set field_name = field.name.name %}
        {% set field_type = field.field_type.field_type %}

        {% if field_type == bool %}    
            {{ bool_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 1 %}
        {% elif field_type == np.uint8 %}    
            {{ uint8_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 1 %}
        {% elif field_type == np.uint16 %}    
            {{ uint16_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 1 %}
        {% elif field_type == np.int16 %}    
            {{ int16_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 1 %}
        {% elif field_type == np.uint32 or field_type == int %}    
            {{ uint32_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 2 %}
        {% elif field_type == float %}    
            {{ float_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 2 %}
        {% elif field_type == str or field_type == bytes %}    
            {{ string64_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 32 %}
        {% elif issubclass(field_type, Enum) %}    
            {{ enum_layout(field_name, field_type, ns.address) }}
            {% set ns.address = ns.address + 1 %}
        {% elif field_type == Timestamp %}    
            {{ timestamp_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 4 %}
        {% elif field_type == Version %}    
            {{ version_layout(field_name, ns.address) }}
            {% set ns.address = ns.address + 3 %}
        {% else %}
            <tr>
                <td colspan="5">Documentation unavailable</td>
            </tr>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% macro modbus_layout(command_code, fields, start_address=0, is_answer=true) %}
    {{ memory_layout_table(modbus_layout_fields(command_code, fields, start_address, is_answer)) }}
{% endmacro %}

{% macro error_memory_layout_fields() %}
    <tr class="border-t border-slate-100">
        <td>Error Code</td>
        <td>int16</td>
        <td>0</td>
        <td colspan="2"><b>Error code value</b></td>
    </tr>
    {{  string64_layout("Error message", 1) }}
{% endmacro %}

{% macro error_memory_layout(command_code, fields, start_address=0) %}
    {{ memory_layout_table(error_memory_layout_fields()) }}
{% endmacro %}
