{% import "schema_templates.j2" as schema_templates with context %}
{% import "modbus_api.j2" as modbus %}

{# 
  Expected variables:
    - pure_command_contracts: List[CommandContract]
    - error_codes: List[CommandCode]
    - notification_messages: List[CommandContract]
    - custom_enums: List[Type[Enum]]

 Expected globals:
    - protocol_constants: Dict[str, Any]
#}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>UsePAT API Reference</title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-stone-100 text-slate-800 antialiased">
    <section id="title-page" class="manual-title-page">
        <div class="manual-title-wrap">
            <p class="manual-eyebrow">Device protocol reference</p>
            <h1>UsePAT API Reference</h1>
            <p class="manual-title-subtitle">Command and response reference for remote control, diagnostics, and integration work.</p>
            <div class="manual-title-meta">
                <div>
                    <span class="manual-title-meta-label">Device</span>
                    <strong>{{ device_name_to_label(device_type_name) }}</strong>
                </div>
                <div>
                    <span class="manual-title-meta-label">Protocol</span>
                    <strong>{{ protocol_version_str }}</strong>
                </div>
                <div>
                    <span class="manual-title-meta-label">Build</span>
                    <strong>{{ release_type }}</strong>
                </div>
                <div>
                    <span class="manual-title-meta-label">Generated</span>
                    <strong>{{ build_date_str }}</strong>
                </div>
            </div>
        </div>
    </section>

    <main class="manual-doc max-w-6xl mx-auto px-4 py-8 space-y-6">
        {% set has_notifications = include_text and notification_messages|count > 0 %}
        {% set sections = namespace(i=1) %}
        {% set intro_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% if include_modbus %}
            {% set modbus_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% endif %}
        {% if include_text %}
            {% set text_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% endif %}
        {% set types_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% set commands_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% set errors_no = sections.i %}{% set sections.i = sections.i + 1 %}
        {% if has_notifications %}
            {% set notifications_no = sections.i %}
        {% endif %}

        <section id="document-index" class="manual-section">
            <h2 class="manual-section-title">
                <span class="manual-section-number">0.</span>
                <span>Document Index</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-copy manual-section-intro">Use this index to jump directly to protocol basics, type definitions, command groups, error codes{% if has_notifications %}, and notifications{% endif %}.</p>

            <div class="manual-panel">
                {% macro toc_page(target_id) %}
                    <span class="toc-page ml-3 text-slate-500" data-target="{{ target_id }}" data-page="?">—</span>
                {% endmacro %}

                {% macro render_command_index(nodes, prefix) %}
                    <ul class="text-sm space-y-2">
                        {% for g in nodes %}
                            {% set item_number = prefix ~ "." ~ loop.index %}
                            <li>
                                <div class="flex items-baseline justify-between gap-3">
                                    <a class="text-indigo-700 hover:underline" href="#{{ anchor_group(g.id) }}">
                                        <span class="font-mono text-slate-500 mr-2">{{ item_number }}.</span> {{ g.title }}
                                    </a>
                                    {{ toc_page(anchor_group(g.id)) }}
                                </div>

                                {% if g.commands %}
                                    <ul class="ml-6 mt-1 space-y-2">
                                    {% for command_contract in g.commands %}
                                        <li>
                                            <div class="flex items-baseline justify-between gap-3">
                                                <a class="text-slate-700 hover:underline" href="#{{ anchor_cmd(command_contract.code) }}">
                                                    {{ command_contract.code.value }} - {{ command_contract.code.name }}
                                                </a>
                                                {{ toc_page(anchor_cmd(command_contract.code)) }}
                                            </div>
                                        </li>
                                    {% endfor %}
                                    </ul>
                                {% endif %}

                                {% if g.children %}
                                    <div class="ml-4 mt-2">
                                        {{ render_command_index(g.children, item_number) }}
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endmacro %}

                <ul class="text-sm space-y-2">
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#introduction"><span class="font-mono text-slate-500 mr-2">{{ intro_no }}.</span> Introduction</a>
                            {{ toc_page("introduction") }}
                        </div>
                    </li>
                    {% if include_modbus %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#modbus"><span class="font-mono text-slate-500 mr-2">{{ modbus_no }}.</span> MODBUS API</a>
                            {{ toc_page("modbus") }}
                        </div>
                    </li>
                    {% endif %}
                    {% if include_text %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#text-api"><span class="font-mono text-slate-500 mr-2">{{ text_no }}.</span> Text-based API</a>
                            {{ toc_page("text-api") }}
                        </div>
                    </li>
                    {% endif %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#types"><span class="font-mono text-slate-500 mr-2">{{ types_no }}.</span> Types</a>
                            {{ toc_page("types") }}
                        </div>
                    </li>
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#commands"><span class="font-mono text-slate-500 mr-2">{{ commands_no }}.</span> Commands</a>
                            {{ toc_page("commands") }}
                        </div>
                        <div class="ml-4 mt-2">
                            {{ render_command_index(command_groups, commands_no|string) }}
                        </div>
                    </li>
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#errors"><span class="font-mono text-slate-500 mr-2">{{ errors_no }}.</span> Errors</a>
                            {{ toc_page("errors") }}
                        </div>
                    </li>
                    {% if has_notifications %}
                    <li>
                        <div class="flex items-baseline justify-between gap-3">
                            <a class="text-indigo-700 hover:underline" href="#notifications"><span class="font-mono text-slate-500 mr-2">{{ notifications_no }}.</span> Notifications</a>
                            {{ toc_page("notifications") }}
                        </div>
                    </li>
                    {% endif %}
                </ul>
            </div>

        </section>
        <section id="introduction" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ intro_no }}.</span>
                <span>Introduction</span>
            </h2>
            <div class="major-heading-separator"></div>

            <h3 class="manual-subheading">How to read this reference</h3>
            <p class="manual-lead">
                This reference describes the commands a device accepts, the values each command needs, and the data you get back.
            </p>
            <p class="manual-copy">
                The protocol follows a simple request and response model. You send a command, the device processes it, and it returns either a normal response or an error. Each response field in this document lists the expected name, type, and meaning.
            </p>

            <p class="manual-copy">
                {% if include_text and include_modbus %}
                Some devices also send notifications or log messages without being asked first. These asynchronous messages are available on the text protocol, but not through MODBUS.
                {% elif include_text %}
                Some devices also send notifications or log messages without being asked first. These asynchronous messages are included in the text protocol.
                {% endif %}
            </p>

            <p class="manual-copy">
                {% if include_text and include_modbus %}
                The same command set can be exposed through different transports. This manual documents the text protocol used by Sonic Control and the MODBUS register layout used for industrial integration.
                {% elif include_text %}
                This manual documents the text protocol used by Sonic Control.
                {% elif include_modbus %}
                This manual documents the MODBUS register layout used for industrial integration.
                {% endif %}
            </p>
        </section>

        {% if include_modbus %}
        <section id="modbus" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ modbus_no }}.</span>
                <span>MODBUS API</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-lead">
                MODBUS access is organized around two mailbox areas: one for requests and one for responses.
            </p>

            <p class="manual-copy">
                Each mailbox is a block of 16-bit registers. To execute a command, write the request header and payload into the command mailbox, then set the execute flag. The device writes the result into the response mailbox. If execution fails, the response contains an error code and message instead of the normal command response.
            </p>

            <div class="overflow-x-auto my-4">
                <table class="manual-table w-full text-sm border-collapse table-fixed">
                    <colgroup>
                        <col class="w-[20%]" />
                        <col class="w-[15%]" />
                        <col class="w-[25%]" />
                        <col class="w-[40%]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-left px-3 py-2">Mailbox</th>
                            <th class="text-left px-3 py-2">Start register</th>
                            <th class="text-left px-3 py-2">Purpose</th>
                            <th class="text-left px-3 py-2">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-3 py-2 font-semibold text-slate-800">Response mailbox</td>
                            <td class="px-3 py-2">0</td>
                            <td class="px-3 py-2">Read the latest response</td>
                            <td class="px-3 py-2">Starts with a pending flag and a response-length field. This area is read-only.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2 font-semibold text-slate-800">Command mailbox</td>
                            <td class="px-3 py-2">1024</td>
                            <td class="px-3 py-2">Write a command request</td>
                            <td class="px-3 py-2">Starts with an execute flag, a transceiver id, the command code, and the command payload.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="manual-copy">
                This implementation uses MODBUS function <code>0x10</code> to write command requests and <code>0x04</code> to read responses. While a command is still running, the response mailbox stays marked as pending and the device may answer with a busy indication.
            </p>

            {% if is_postman_device %}
            <h3 class="manual-subheading">Postman routing</h3>
            <p class="manual-copy">
                When a Postman forwards commands to a second MODBUS network, the slave id in the MODBUS frame still addresses the Postman itself. The transceiver id inside the mailbox then selects the final target on the downstream network.
            </p>
            <div class="overflow-x-auto my-4">
                <table class="manual-table w-full text-sm border-collapse table-fixed">
                    <colgroup>
                        <col class="w-[22%]" />
                        <col class="w-[78%]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-left px-3 py-2">Transceiver id</th>
                            <th class="text-left px-3 py-2">Meaning</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-3 py-2">255</td>
                            <td class="px-3 py-2">Execute the command on the Postman itself.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2">1 to 254</td>
                            <td class="px-3 py-2">Forward the command to that device id on the second network.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2">256</td>
                            <td class="px-3 py-2">Reserved for the directly connected downstream device.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2">0</td>
                            <td class="px-3 py-2">Reserved for broadcast forwarding. This is currently not implemented.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            {% endif %}

        </section>
        {% endif %}

        {% if include_text %}
        <section id="text-api" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ text_no }}.</span>
                <span>Text-based API</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-lead">
                The text protocol is the easiest format to read by hand and the one used by Sonic Control.
            </p>

            <p class="manual-copy">
                Commands are sent as readable strings, which makes this format useful for debugging in a serial terminal. Most command names start with <code>?</code> for read operations or <code>!</code> for write operations. Some commands also accept an index, either directly after the name or inside brackets.
            </p>

            <div class="overflow-x-auto my-4">
                <table class="manual-table w-full text-sm border-collapse table-fixed">
                    <colgroup>
                        <col class="w-[22%]" />
                        <col class="w-[78%]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-left px-3 py-2">Pattern</th>
                            <th class="text-left px-3 py-2">Meaning</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-3 py-2"><code>?frequency</code></td>
                            <td class="px-3 py-2">Read the current value of a field.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>!frequency=xxx</code></td>
                            <td class="px-3 py-2">Write a new value to a field.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>!atf1=xxx</code></td>
                            <td class="px-3 py-2">Write a value to a numeric index.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>!log[appLogger]=INFO</code></td>
                            <td class="px-3 py-2">Write a value to a named index.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="manual-copy">
                Requests and responses end with <code>\r</code>. Response fields are separated with <code>#</code>, and the first field always contains the command code or error code.
            </p>

            <div class="overflow-x-auto my-4">
                <table class="manual-table w-full text-sm border-collapse table-fixed">
                    <colgroup>
                        <col class="w-[28%]" />
                        <col class="w-[72%]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-left px-3 py-2">Prefix</th>
                            <th class="text-left px-3 py-2">Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-3 py-2"><code>LOG=</code></td>
                            <td class="px-3 py-2">Log message from the device.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>NOTIFY=</code></td>
                            <td class="px-3 py-2">Notification sent without a matching request.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>COM#&lt;ID&gt;=</code></td>
                            <td class="px-3 py-2">Command request. The id is optional and mainly used by Sonic Control.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>ANS#&lt;ID&gt;=</code></td>
                            <td class="px-3 py-2">Command response. The id matches the original request so clients can pair them reliably.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        {% endif %}

        <section id="types" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ types_no }}.</span>
                <span>Types</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-copy">
                Commands in this manual use a mix of primitive values, structured values, and enums. The most common types are listed below.
            </p>
            <div class="overflow-x-auto my-4">
                <table class="manual-table w-full text-sm border-collapse table-fixed">
                    <colgroup>
                        <col class="w-[22%]" />
                        <col class="w-[78%]" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th class="text-left px-3 py-2">Type</th>
                            <th class="text-left px-3 py-2">Meaning</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="px-3 py-2"><code>bool</code>, <code>uint8</code>, <code>uint16</code>, <code>uint32</code>, <code>int16</code>, <code>float</code></td>
                            <td class="px-3 py-2">Primitive values used directly in request and response fields.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>str</code></td>
                            <td class="px-3 py-2">
                                {% if include_text and include_modbus %}
                                Text value. The exact representation depends on the transport.
                                {% elif include_text %}
                                Text value represented directly in the text protocol.
                                {% elif include_modbus %}
                                Text value stored in the MODBUS mailbox string layout.
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>Version</code></td>
                            <td class="px-3 py-2">Semantic version with major, minor, and patch components.</td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2"><code>Timestamp</code></td>
                            <td class="px-3 py-2">
                                {% if include_text and include_modbus %}
                                Represents a point in time. The exact wire format depends on the transport.
                                {% elif include_text %}
                                Represents a point in time using separate date and time fields.
                                {% elif include_modbus %}
                                Represents a point in time as POSIX time in the MODBUS mailbox.
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <td class="px-3 py-2">Enums</td>
                            <td class="px-3 py-2">Named sets of fixed values used for modes, states, and options.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h3 class="manual-subheading">Version</h3>
            <p class="manual-copy">
                <code>Version</code> contains <code>major_version</code>, <code>minor_version</code>, and <code>patch_version</code>.
            </p>

            <h3 class="manual-subheading">Timestamp</h3>
                {% if include_modbus %}
                <p class="manual-copy">
                    On MODBUS, a timestamp is stored as POSIX time in seconds since the Unix epoch. It occupies four 16-bit registers.
                </p>
                {% endif %}
                {% if include_text %}
                <p class="manual-copy">
                    In the text protocol, a timestamp is split into separate fields for <code>hour</code>, <code>minute</code>, <code>seconds</code>, <code>day</code>, <code>month</code>, and <code>year</code>.
                </p>
                {% endif %}

            <h3 class="manual-subheading">Enums</h3>
            <div>
                {% for enum_class in enum_classes %}
                    {{ schema_templates.enum_class_entry(enum_class) }}
                {% endfor %}
            </div>
        </section>

        <section id="commands" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ commands_no }}.</span>
                <span>Commands</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-section-intro">Commands are grouped by topic. When a command accepts parameters, they are listed below together with the response fields and any transport-specific representation.</p>

            {# ---------------- Grouped Content ---------------- #}
            <div class="mt-8">
                {% macro render_groups(nodes, prefix) %}
                {% for g in nodes %}
                    {% set group_number = prefix ~ "." ~ loop.index %}
                    {% set level = 3 + g.depth %}
                    {% if level > 6 %}{% set level = 6 %}{% endif %}

                    <div id="{{ anchor_group(g.id) }}" class="mt-10 command-group-block{% if g.depth == 0 %} command-group-top{% else %} command-group-sub{% endif %}">
                    {% if level == 3 %}<h3 class="manual-group-heading manual-group-heading-l1"><span class="group-number">{{ group_number }}.</span> {{ g.title }}</h3>{% endif %}
                    {% if level == 4 %}<h4 class="manual-group-heading manual-group-heading-l2"><span class="group-number">{{ group_number }}.</span> {{ g.title }}</h4>{% endif %}
                    {% if level == 5 %}<h5 class="manual-group-heading manual-group-heading-l3"><span class="group-number">{{ group_number }}.</span> {{ g.title }}</h5>{% endif %}
                    {% if level == 6 %}<h6 class="manual-group-heading manual-group-heading-l4"><span class="group-number">{{ group_number }}.</span> {{ g.title }}</h6>{% endif %}

                    {% if g.description %}
                        <p class="manual-copy">{{ g.description }}</p>
                    {% endif %}

                    {% for command_contract in g.commands %}
                        {% set cmd_level = level + 1 %}
                        {% if cmd_level > 6 %}{% set cmd_level = 6 %}{% endif %}
                        {% if cmd_level == 3 %}
                            <h3 id="{{ anchor_cmd(command_contract.code) }}" class="manual-command-heading manual-command-heading-l1">{{ command_contract.code.value }} - {{ command_contract.code.name }}</h3>
                        {% endif %}
                        {% if cmd_level == 4 %}
                            <h4 id="{{ anchor_cmd(command_contract.code) }}" class="manual-command-heading manual-command-heading-l1">{{ command_contract.code.value }} - {{ command_contract.code.name }}</h4>
                        {% endif %}
                        {% if cmd_level == 5 %}
                            <h5 id="{{ anchor_cmd(command_contract.code) }}" class="manual-command-heading manual-command-heading-l2">{{ command_contract.code.value }} - {{ command_contract.code.name }}</h5>
                        {% endif %}
                        {% if cmd_level == 6 %}
                            <h6 id="{{ anchor_cmd(command_contract.code) }}" class="manual-command-heading manual-command-heading-l2">{{ command_contract.code.value }} - {{ command_contract.code.name }}</h6>
                        {% endif %}

                        {{ schema_templates.command_contract_entry(command_contract, False) }}
                    {% endfor %}

                    {% if g.children %}
                        {{ render_groups(g.children, group_number) }}
                    {% endif %}
                    </div>
                {% endfor %}
                {% endmacro %}

                {{ render_groups(command_groups, commands_no|string) }}
            </div>
        </section>

        <section id="errors" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ errors_no }}.</span>
                <span>Errors</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-copy">If a command cannot be completed, the device returns one of the error codes listed here.</p>
            <div>
                {% for error_code in error_codes | sort(attribute="value") %}
                    {{ schema_templates.command_code_headline(error_code) }}
                {% endfor %}
            </div>
            {% if include_modbus %}
                <h3 class="manual-subheading">MODBUS API</h3>
                <p class="manual-copy">Error responses use the following register layout.</p>
                <div>
                    {{ modbus.error_memory_layout() }}
                </div>
            {% endif %}
        </section>

        {% if has_notifications %}
        <section id="notifications" class="manual-section page-break-before">
            <h2 class="manual-section-title">
                <span class="manual-section-number">{{ notifications_no }}.</span>
                <span>Notifications</span>
            </h2>
            <div class="major-heading-separator"></div>
            <p class="manual-copy">Notifications are unsolicited device messages.</p>
            <div>
                {% for notification in notification_messages | sort(attribute="code") %}
                    {{ schema_templates.command_contract_entry(notification )}}
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </main>

    <footer class="max-w-6xl mx-auto px-4 py-6 text-sm text-slate-500">
        <div class="flex justify-between items-center">
            <div>Generated by UsePAT</div>
            <div>&copy; {{ now().year }}</div>
        </div>
    </footer>

    <style>
        :root {
            --manual-font-sans: "Calibri", "Segoe UI", Arial, Helvetica, sans-serif;
            --manual-font-mono: Consolas, "Courier New", monospace;
            --manual-font-serif: Cambria, Georgia, "Times New Roman", serif;
            --manual-paper: #fcfbf7;
            --manual-panel: #ffffff;
            --manual-ink: #1e293b;
            --manual-muted: #5b677a;
            --manual-rule: #d9e0e7;
            --manual-accent: #0f766e;
            --manual-accent-soft: #dff4f1;
            --manual-accent-deep: #0b5d56;
            --manual-table-stripe: #fbfcfd;
            --manual-command-bg: linear-gradient(180deg, rgba(248,251,252,0.96), rgba(255,255,255,1));
        }

        body {
            font-family: var(--manual-font-sans);
            color: var(--manual-ink);
            background:
                linear-gradient(180deg, #e9efe9 0, #f6f3eb 22rem, #f2efe8 100%),
                var(--manual-paper);
        }
        pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Roboto Mono", "Source Code Pro", monospace; }
        pre, code { font-family: var(--manual-font-mono); }
        code { background: rgba(15,23,42,0.05); padding: .1rem .3rem; border-radius: .2rem; }
        .manual-doc { line-height: 1.58; }
        .manual-title-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1.5rem;
            background:
                radial-gradient(circle at top left, rgba(15,118,110,0.12), transparent 30%),
                radial-gradient(circle at bottom right, rgba(180,83,9,0.08), transparent 32%),
                var(--manual-paper);
        }
        .manual-title-wrap {
            width: min(980px, 100%);
            padding: 3.6rem 3.2rem;
            border: 1px solid var(--manual-rule);
            background: rgba(255,255,255,0.84);
            box-shadow: 0 20px 60px rgba(15, 23, 42, 0.06);
        }
        .manual-eyebrow {
            margin: 0 0 1rem;
            font-size: 0.82rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--manual-accent);
            font-weight: 700;
        }
        h1, h2, h3, h4, h5, h6 {
            letter-spacing: -0.01em;
            color: rgb(15 23 42);
        }
        h1, h2, h3 { font-family: var(--manual-font-serif); }
        h1 {
            font-size: clamp(2.8rem, 4vw, 4.2rem);
            line-height: 1.03;
            margin: 0;
        }
        .manual-title-subtitle {
            margin: 1rem 0 0;
            max-width: 42rem;
            font-size: 1.12rem;
            line-height: 1.6;
            color: var(--manual-muted);
        }
        .manual-title-meta {
            margin-top: 2rem;
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid var(--manual-rule);
        }
        .manual-title-meta > div {
            display: grid;
            gap: 0.18rem;
        }
        .manual-title-meta-label {
            font-size: 0.76rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--manual-muted);
        }
        .manual-section {
            background: var(--manual-panel);
            border: 1px solid var(--manual-rule);
            padding: 1.4rem 1.2rem 1.65rem;
            position: relative;
        }
        .manual-section::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: 3px;
            background: linear-gradient(180deg, var(--manual-accent) 0%, rgba(15,118,110,0.18) 100%);
        }
        .manual-section-title {
            display: flex;
            align-items: baseline;
            gap: 0.75rem;
            font-size: 1.55rem;
            font-weight: 700;
            margin: 0;
            padding-left: 0.1rem;
        }
        .manual-section-number {
            font-family: var(--manual-font-mono);
            font-size: 0.88rem;
            letter-spacing: 0.04em;
            color: var(--manual-accent);
            min-width: 2.9rem;
        }
        .manual-section-intro {
            margin: 1rem 0 0;
            max-width: 60rem;
        }
        .manual-subheading {
            font-family: var(--manual-font-serif);
            font-size: 1.02rem;
            font-weight: 700;
            margin: 1.5rem 0 0.6rem;
        }
        .manual-lead {
            margin: 1rem 0 0.8rem;
            font-size: 1.04rem;
            line-height: 1.65;
            color: #334155;
        }
        .manual-copy {
            margin: 0.8rem 0;
            color: var(--manual-muted);
        }
        .manual-panel {
            margin-top: 1rem;
            padding: 1rem 1.1rem;
            border: 1px solid var(--manual-rule);
            background: linear-gradient(180deg, #fafcfc 0%, #ffffff 100%);
        }
        .manual-subsection-title {
            margin: 1rem 0 0.55rem;
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: none;
            letter-spacing: 0.01em;
            color: var(--manual-accent-deep);
        }
        .manual-command-code {
            font-size: 1.14rem;
            font-weight: 700;
            color: var(--manual-ink);
        }
        .manual-command-code-name {
            letter-spacing: -0.015em;
        }
        .manual-command-code-badge {
            display: inline-flex;
            align-items: center;
            padding: 0.28rem 0.62rem;
            background: var(--manual-accent-soft);
            border: 1px solid #b9e6df;
            color: #115e59;
            font-family: var(--manual-font-mono);
            font-size: 0.92rem;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
        }
        .manual-chip {
            display: inline-flex;
            align-items: center;
            margin: 0.15rem 0.35rem 0.15rem 0;
            padding: 0.22rem 0.58rem;
            border: 1px solid #d7dee7;
            background: linear-gradient(180deg, #ffffff 0%, #f8fbfc 100%);
            color: #334155;
            font-size: 0.84rem;
            white-space: nowrap;
        }
        .manual-group-heading {
            margin: 1.9rem 0 0.55rem;
            font-family: var(--manual-font-serif);
            font-weight: 700;
            color: #162435;
        }
        .manual-group-heading-l1 { font-size: 1.22rem; }
        .manual-group-heading-l2 { font-size: 1.08rem; }
        .manual-group-heading-l3,
        .manual-group-heading-l4 { font-size: 1rem; }
        .manual-command-heading {
            margin: 1.1rem 0 0.55rem;
            font-family: var(--manual-font-serif);
            font-weight: 700;
            color: #142033;
            letter-spacing: -0.01em;
            line-height: 1.25;
        }
        .manual-command-heading-l1 { font-size: 1.02rem; }
        .manual-command-heading-l2 { font-size: 0.96rem; }
        .manual-group-heading .group-number,
        h3 > .group-number,
        h4 > .group-number,
        h5 > .group-number,
        h6 > .group-number {
            display: inline-block !important;
            color: var(--manual-accent);
            margin-right: .5rem;
            font-family: var(--manual-font-mono);
        }
        .manual-command-card {
            margin-top: 0.9rem;
            background: var(--manual-command-bg);
            border: 1px solid #d8e2ea !important;
            position: relative;
            padding: 1rem 1rem 1.15rem !important;
        }
        .manual-command-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--manual-accent) 0%, rgba(15,118,110,0.16) 100%);
        }
        .command-header-block {
            padding-bottom: 0.2rem;
            border-bottom: 1px solid rgba(217,224,231,0.72);
            margin-bottom: 0.85rem;
        }
        .manual-tag-row {
            margin-top: 0.45rem;
        }
        .manual-field-card {
            border: 1px solid var(--manual-rule);
            padding: 0.95rem 1rem;
            background: #fff;
        }
        .manual-field-card-title {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--manual-ink);
        }
        .manual-field-card-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 0.7rem 1rem;
            margin: 0.75rem 0 0;
        }
        .manual-field-card-grid dt {
            font-size: 0.73rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--manual-muted);
        }
        .manual-field-card-grid dd {
            margin: 0.16rem 0 0;
            color: var(--manual-ink);
        }
        .manual-field-card-wide { grid-column: 1 / -1; }
        .manual-field-card-description {
            margin: 0.8rem 0 0;
            color: var(--manual-muted);
        }
        .manual-enum-caption {
            margin-bottom: 0.35rem;
        }
        .manual-enum-name {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--manual-ink);
        }
        .manual-enum-count {
            font-size: 0.8rem;
            color: var(--manual-muted);
        }
        .manual-enum-table thead th {
            font-size: 0.72rem;
        }
        .manual-enum-table tbody td {
            font-size: 0.88rem;
        }

        .manual-table {
            border-radius: 0;
            overflow: hidden;
            border: 1px solid rgb(211 219 229);
            background: white;
        }
        .manual-table thead th {
            background: linear-gradient(180deg, #f8fafc 0%, #eef3f6 100%);
            color: rgb(31 41 55);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 1px solid rgb(203 213 225);
        }
        .manual-table tbody tr:nth-child(even) {
            background: var(--manual-table-stripe);
        }
        .manual-table tbody td {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            padding-top: 0.5rem;
            padding-bottom: 0.5rem;
            border-top: 1px solid rgb(226 232 240);
            vertical-align: top;
            color: rgb(30 41 59);
            line-height: 1.42;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .manual-table tbody th {
            padding-left: 0.75rem;
            padding-right: 0.75rem;
            border-top: 1px solid rgb(226 232 240);
            color: rgb(30 41 59);
            font-size: 0.8rem;
            font-weight: 600;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        section.bg-white,
        article.bg-white,
        .bg-white.border,
        .not-prose.bg-slate-50,
        .manual-section,
        .manual-panel {
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        .major-heading-separator {
            border-top: 1px solid rgb(226 232 240);
            margin-top: 0.75rem;
            margin-left: 0.1rem;
            background: linear-gradient(90deg, rgba(15,118,110,0.16), rgba(15,118,110,0));
            height: 1px;
        }
        .toc-page::before { content: "p. " attr(data-page); }
        .toc-page { min-width: 3.5rem; text-align: right; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { scrollbar-width: none; }

        @media (max-width: 800px) {
            .manual-section::before {
                width: 2px;
            }
            .manual-title-wrap {
                padding: 2rem 1.25rem;
            }
            .manual-title-meta,
            .manual-field-card-grid {
                grid-template-columns: minmax(0, 1fr);
            }
            .manual-section {
                padding: 1.05rem 0.85rem 1.2rem;
            }
            .manual-section-number {
                min-width: 2.2rem;
            }
        }

        @media print {
            @page {
                size: A4;
                margin: 12mm 8mm;
            }

            body { background: white !important; }
            .manual-section::before,
            .manual-command-card::before {
                display: none;
            }
            .manual-title-page {
                background: white !important;
                padding: 0;
            }
            .manual-title-wrap {
                box-shadow: none;
                background: white;
            }
            .manual-command-card {
                background: white !important;
            }
            .manual-table tbody tr:nth-child(even) {
                background: transparent !important;
            }
            .page-break-before { break-before: page; page-break-before: always; }
            .avoid-break { break-inside: avoid; page-break-inside: avoid; }
            .overflow-x-auto { overflow: visible !important; }
            .manual-table { min-width: 0 !important; width: 100% !important; }
            #document-index { break-inside: auto; page-break-inside: auto; }
            table { break-inside: auto; page-break-inside: auto; }
            tr, td, th { break-inside: avoid; page-break-inside: avoid; }
            h2, h3, h4, h5, h6 { break-after: avoid; page-break-after: avoid; }
            h2 + *, h3 + *, h4 + *, h5 + *, h6 + * { break-before: avoid; page-break-before: avoid; }
            #commands h3 + *, #commands h4 + *, #commands h5 + *, #commands h6 + * { break-before: avoid; page-break-before: avoid; }
            #commands .command-group-top { break-before: page; page-break-before: always; }
            #commands .command-group-top:first-child { break-before: auto; page-break-before: auto; }
            #commands .command-group-sub + .command-group-sub { break-before: page; page-break-before: always; }
            #commands .param-list, #commands .answer-field-list { break-inside: auto; page-break-inside: auto; }
            #commands .param-item, #commands .answer-field-item, #commands .field-entry-card {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            #commands .modbus-section-title,
            #commands .modbus-layout-title {
                break-after: avoid;
                page-break-after: avoid;
            }
            #commands .modbus-section-title + .modbus-layout-block,
            #commands .modbus-layout-title + .modbus-layout-table {
                break-before: avoid;
                page-break-before: avoid;
            }
            #types .enum-entry {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            #types .enum-entry-content,
            #types .enum-table-wrap {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            #types .enum-entry table,
            #types .enum-entry thead,
            #types .enum-entry tbody {
                break-inside: avoid;
                page-break-inside: avoid;
            }
            #types .enum-table-wrap { overflow: visible !important; }
            a { color: inherit; text-decoration: none; }
            .shadow-sm { box-shadow: none !important; }
            section.bg-white,
            article.bg-white,
            .bg-white.border,
            .not-prose.bg-slate-50,
            .manual-section,
            .manual-panel {
                border-radius: 0 !important;
                box-shadow: none !important;
            }
            .toc-page { min-width: 4rem; text-align: right; }
        }
    </style>

    <script>
        (function () {
            function mmToPx(mm) {
                const probe = document.createElement("div");
                probe.style.position = "absolute";
                probe.style.visibility = "hidden";
                probe.style.height = "100mm";
                document.body.appendChild(probe);
                const px = probe.getBoundingClientRect().height / 100;
                document.body.removeChild(probe);
                return mm * px;
            }

            window.updateTocPageNumbers = function updateTocPageNumbers() {
                const pageHeightPx = mmToPx(297);
                const marginTopPx = mmToPx(14);
                const marginBottomPx = mmToPx(14);
                const printableHeight = pageHeightPx - marginTopPx - marginBottomPx;

                document.querySelectorAll(".toc-page[data-target]").forEach(function (pageEl) {
                    const targetId = pageEl.getAttribute("data-target");
                    const target = document.getElementById(targetId);
                    if (!target || printableHeight <= 0) {
                        pageEl.setAttribute("data-page", "?");
                        return;
                    }

                    const top = target.getBoundingClientRect().top + window.scrollY;
                    const page = Math.max(1, Math.floor(top / printableHeight) + 1);
                    pageEl.setAttribute("data-page", String(page));
                });
            };

            window.addEventListener("load", window.updateTocPageNumbers);
            window.addEventListener("resize", window.updateTocPageNumbers);
            window.addEventListener("beforeprint", window.updateTocPageNumbers);
        })();
    </script>
</body>
</html>
