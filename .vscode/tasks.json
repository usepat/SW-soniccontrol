{
    "version": "2.0.0",
    "tasks": [
        {   
            "label": "Install editable build",
            "type": "shell",
            "command": "source '${workspaceFolder}/.venv/bin/activate' && pip install -e '${workspaceFolder}'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
        },
        {
            "label": "Build SonicControl with PyInstaller",
            "type": "shell",
            "linux": { 
                "command": "bash '${workspaceFolder}/scripts/create_exe.sh'" 
            },
            "windows": {
                "command": "${workspaceFolder}/scripts/create_exe.bat",
                "args": [
                    "${workspaceFolder}"
                ]
            },
            "dependsOn":[
                "Install editable build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }, 
        {
            "label": "Run unit tests of current file",
            "type": "shell",
            "command": "pytest",
            "args": [
                "'${relativeFile}'"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Build AppImage for linux",
            "type": "shell",
            "linux": { 
                "command": "bash '${workspaceFolder}/scripts/linux_deployment/create_app_image.sh'" 
            },
            "dependsOn":[
                "Install editable build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Install plugins",
            "type": "shell",
            "linux": { 
                "command": "bash '${workspaceFolder}/scripts/install_plugins.sh'" 
            },
            "dependsOn":[
                "Install editable build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build Documentation",
            "type": "shell",
            "command": "doxygen",
            "args": [
                "'${workspaceFolder}/docs/DoxyFile'"
            ],
            "group": {
                "kind": "build"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        }
    ]
}
