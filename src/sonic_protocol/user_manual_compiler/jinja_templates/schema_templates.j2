{% import "modbus_api.j2" as modbus %}


{% macro field_entry(field_name, field_type, description) %}
    <div class="bg-white border border-slate-200 rounded-none p-4 mb-4 field-entry-card">
        <div class="text-sm font-semibold text-slate-800 mb-1">{{ field_name.name }}</div>

        <p class="text-sm text-slate-600 mb-1">Type:
            <b class="text-slate-800">
            {% if field_type.converter_ref == ConverterType.ENUM %}
                enum
            {% elif field_type.converter_ref != ConverterType.PRIMITIVE %}
                struct
            {% endif %}
            {{ field_type.field_type.__name__ }}
            </b>
        </p>

        {% set unit_prefix = field_type.si_prefix.value if field_type.si_prefix is not none else "" %}
        {% set si_unit = field_type.si_unit.value if field_type.si_unit is not none else "" %}
        {% set unit = unit_prefix ~ si_unit %}
        {% if unit != "" %}
            <p class="text-sm text-slate-600 mb-2">Unit: <b class="text-slate-800">{{ unit }}</b></p>
        {% endif %}
        
        <div class="text-sm text-slate-600 mb-2">
            {% set has_min_value = field_type.min_value is not none %}
            {% set has_max_value = field_type.max_value is not none %}
            {% set has_constraints = has_min_value or has_max_value or field_type.allowed_values is not none %}

            {% if has_constraints %}
                <div class="mb-2 font-medium text-slate-700">Allowed values:</div>

                {% if has_max_value or field_type.max_value is not none %}
                    <div class="mb-1">
                        Range:
                        <span class="font-mono text-slate-800">{{ protocol_constants[field_type.min_value.value] if has_min_value else "[type-dependent minimum]" }}</span>
                        to <span class="font-mono text-slate-800">{{ protocol_constants[field_type.max_value.value] if has_max_value else "[type-dependent maximum]" }}</span>
                    </div>
                {% endif %}
                {% if field_type.allowed_values is not none %}
                    <ul class="list-disc pl-6">
                        {% for value in field_type.allowed_values %}
                            <li class="text-sm">{{ value }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            {% endif %}
        </div>

        {% if description is not none %}
            <p class="text-sm text-slate-600 mt-2">{{ description }}</p>
        {% endif %}
    </div>
{% endmacro %}


{% macro param_entry(command_param) %}
    {{ field_entry(command_param.name, command_param.param_type, command_param.user_manual_attrs.description) }}
{% endmacro %}

{% macro answer_field_entry(answer_field_def) %}
    {{ field_entry(answer_field_def.field_name, answer_field_def.field_type, answer_field_def.user_manual_attrs.description) }}
{% endmacro %}


{% macro command_code_headline(command_code) %}
    <div class="text-base font-semibold text-slate-800 mb-3 flex items-center gap-3">
        <span class="inline-flex font-mono text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded">{{ command_code.value }}</span>
        <span>- {{ command_code.name }}</span>
    </div>
{% endmacro %}

{% macro command_contract_entry(command_contract, show_header=True) %}
    <article class="bg-white border border-slate-200 rounded-none p-4 shadow-none mb-6">
        <div class="command-header-block avoid-break">
            {% if show_header %}
                {{ command_code_headline(command_contract.code) }}
            {% endif %}

            {% set command_description = command_contract.user_manual_attrs.description %}
            {% if (command_description is none or command_description|trim == "") and command_contract.command_def is not none %}
                {% set command_description = command_contract.command_def.user_manual_attrs.description %}
            {% endif %}
            
            {% if command_contract.tags|count != 0 %}
                <div class="mt-2 flex items-center gap-3">
                    <div class="text-sm text-slate-600 whitespace-nowrap">Tags:</div>
                    <div class="flex gap-2 overflow-x-auto no-scrollbar py-1">
                        {% for tag in command_contract.tags %}
                            <span class="whitespace-nowrap text-sm bg-white border border-slate-300 text-slate-700 px-3 py-1 rounded-none">{{ tag }}</span>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            
            {% if command_description is not none and command_description|trim != "" %}
                <p class="text-sm text-slate-600 mb-3">{{ command_description }}</p>
            {% endif %}
        </div>

        {% if command_contract.command_def is not none %}
            <div class="params-block avoid-break">
                <div class="text-sm font-medium text-slate-800 mb-2">Parameters:</div>
                {% set command_parameters = [command_contract.command_def.index_param, command_contract.command_def.setter_param] %}
                {% if any(command_parameters) %}
                    <ol class="list-decimal pl-6 mb-3 param-list">
                    {% for command_param in command_parameters %}
                        {% if command_param is not none %}
                            <li class="mb-2 param-item avoid-break">
                                {{ param_entry(command_param) }}
                            </li>
                        {% endif %}
                    {% endfor %}
                    </ol>
                {% else %}
                    <p class="text-sm text-slate-600 mb-3">No parameters.</p>
                {% endif %}
            </div>
        {% endif %}

        {% set answer_fields = command_contract.answer_def.fields %}
        {% if answer_fields|count != 0 %}
            <div class="answer-fields-first-block avoid-break">
                <div class="text-sm font-medium text-slate-800 mb-2">Answer fields:</div>
                <ol class="list-decimal pl-6 mb-4 answer-field-list">
                    <li class="mb-3 answer-field-item avoid-break">
                        {{ answer_field_entry(answer_fields[0]) }}
                    </li>
                </ol>
            </div>

            {% if answer_fields|count > 1 %}
                <ol class="list-decimal pl-6 mb-4 answer-field-list" start="2">
                {% for answer_field_def in answer_fields[1:] %}
                    <li class="mb-3 answer-field-item avoid-break">
                        {{ answer_field_entry(answer_field_def) }}
                    </li>
                {% endfor %}
                </ol>
            {% endif %}
        {% else %}
            <div class="text-sm font-medium text-slate-800 mb-2">Answer fields:</div>
            <p class="text-sm text-slate-600 mb-4">No response fields.</p>
        {% endif %}

        {% if include_modbus %}
            <div class="text-sm font-medium text-slate-800 mb-2 mt-8 modbus-section-title">MODBUS API</div>
            {% set is_notification = command_contract.command_def is none and command_contract.code.value < 20000 %}
            {% if is_notification %}
                <p class="text-sm text-slate-600">Notification messages are not supported for MODBUS.</p>
            {% else %}
                {% if command_contract.command_def is not none %}
                <div class="mb-4 modbus-layout-block">
                    <p class="text-sm text-slate-600 mb-2 modbus-layout-title">Command request memory layout:</p>
                    <div class="modbus-layout-table">
                        {{ modbus.modbus_layout(command_contract.code, command_contract.command_def.field_defs(), 1024, false) }}
                    </div>
                </div>
                {% endif %}

                <div class="pt-4 border-t border-slate-100 mt-4 modbus-layout-block">
                    <p class="text-sm text-slate-600 mb-2 modbus-layout-title">Response memory layout:</p>
                    <div class="modbus-layout-table">
                        {{ modbus.modbus_layout(command_contract.code, command_contract.answer_def.field_defs()) }}
                    </div>
                </div>
            {% endif %}
        {% endif %}

        {% if include_text %}
            <div class="text-sm font-medium text-slate-800 mb-2 mt-12">Text-based API</div>
            {% if command_contract.command_def is not none %}
                <p class="text-sm text-slate-600 mb-2">Command identifiers:
                    <ul class="list-disc pl-6">
                    {% for identifier in command_contract.command_def.sonic_text_attrs.string_identifier %}
                        <li>{{ identifier }}</li>
                    {% endfor %}
                    </ul>
                </p>
                {% set text_example = deduce_single_command_example_for_contract(protocol_consts, command_contract) %}
                {% if text_example is not none and text_example|trim != "" %}
                    <p class="text-sm text-slate-600 mb-3">Example command: <code>{{ text_example }}</code></p>
                {% endif %}
            {% endif %}
        {% endif %}
    </article>
{% endmacro %}


{% macro enum_class_entry(enum_class) %}
    <section class="enum-entry bg-white border border-slate-200 rounded-none p-4 mb-6 shadow-none">
        <div class="enum-entry-content avoid-break">
            <div class="enum-table-wrap">
                <table class="manual-table w-full text-sm border-collapse">
                <caption class="caption-top text-left mb-2">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-semibold text-slate-800">{{ enum_class.__name__ }}</span>
                        <span class="text-xs text-slate-500">{{ enum_class|length }} entries</span>
                    </div>
                </caption>
                <colgroup>
                    <col class="w-[10%]" />
                    <col class="w-[90%]" />
                </colgroup>
                    <thead class="text-left text-xs text-slate-600">
                        <tr>
                            <th class="pr-4">Index</th>
                            <th>Name</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for i, enum_member in enumerate(enum_class) %}
                            <tr class="border-t border-slate-100">
                                <td class="py-2 pr-4 font-mono text-slate-800">{{ i }}</td>
                                <td class="py-2 text-slate-800">{{ enum_member.name }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endmacro %}